# Optional overrides for `npm run demo`.
# The launcher normally detects a private Wi-Fi address automatically.
FACEROLL_DEMO_HOST=192.168.1.100

# Override these only when the one-time TLS setup used different locations.
# FACEROLL_TLS_CERT=/path/to/faceroll-server.pem
# FACEROLL_TLS_KEY=/path/to/faceroll-server.key
# FACEROLL_PYTHON=/path/to/recognition/.venv/bin/python
