# Android Studio emulator: routes to the development computer's loopback interface.
EXPO_PUBLIC_RECOGNITION_API_URL=http://10.0.2.2:5055

# Optional local Firebase testing. Leave these unset to use the live project.
# For a physical phone, replace the host with the instructor computer's LAN or Tailscale IP.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.100
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
EXPO_PUBLIC_FIRESTORE_EMULATOR_PORT=8080

# For other environments, use an HTTPS URL trusted by the device.
# Plain LAN HTTP is intentionally rejected because requests contain Firebase tokens
# and temporary facial photographs.
