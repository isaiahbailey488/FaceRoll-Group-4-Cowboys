# Development/native build example. The demo launcher sets these automatically.
# Physical phones need addresses and certificates they can reach and trust.
EXPO_PUBLIC_FIREBASE_MODE=emulator
EXPO_PUBLIC_RECOGNITION_API_URL=https://localhost:5055
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=https://localhost:9449
EXPO_PUBLIC_FIRESTORE_EMULATOR_URL=https://localhost:8443

# Never use the legacy HTTP EXPO_PUBLIC_FIREBASE_EMULATOR_HOST setting.
# See Documentation/CHECKIN_STEP_1.md for encrypted demo and production setup.
