:[{"type":"textnode","content":"Late"}]},{"type":"option","attributes":{"value":"present","selected":true},"components":[{"type":"textnode","content":"Present"}]}]}]},{"type":"text","classes":["help"],"components":[{"type":"textnode","content":"\n                Select the default attendance status for new sessions.\n              "}]}]},{"classes":["form-group"],"components":[{"type":"label","attributes":{"for":"grace-period"},"components":[{"type":"textnode","content":"Grace Period"}]},{"classes":["input-wrap"],"components":[{"type":"input","void":true,"attributes":{"type":"number","name":"gracePeriod","min":"0","max":"120","placeholder":"e.g., 10","id":"grace-period"}},{"tagName":"span","type":"text","classes":["suffix"],"components":[{"type":"textnode","content":"min"}]}]},{"type":"text","classes":["help"],"components":[{"type":"textnode","content":"\n                Minutes after start time students can still be marked present.\n              "}]}]}]},{"tagName":"section","attributes":{"id":"attendance-window-input"},"components":[{"classes":["form-group"],"components":[{"type":"label","attributes":{"for":"attendance-window"},"components":[{"type":"textnode","content":"Attendance Window"}]},{"classes":["input-wrap"],"components":[{"type":"input","void":true,"attributes":{"type":"number","name":"attendanceWindow","min":"0","max":"240","placeholder":"e.g., 30","id":"attendance-window"}},{"tagName":"span","type":"text","classes":["suffix"],"components":[{"type":"textnode","content":"min"}]}]},{"type":"text","classes":["help"],"components":[{"type":"textnode","content":"\n                This controls how long students are allowed to check in after class starts.\n              "}]}]}]},{"classes":["form-group"],"components":[{"classes":["toggle"],"components":[{"type":"button","classes":["toggle-button"],"attributes":{"type":"button","role":"switch","aria-checked":"false","id":"allow-late-toggle"},"components":[{"tagName":"span","classes":["knob"]}]},{"tagName":"span","type":"text","classes":["toggle-label"],"components":[{"type":"textnode","content":"Allow Late Attendance"}]}]},{"type":"text","classes":["help"],"components":[{"type":"textnode","content":"\n              When enabled, students can be marked late after the grace period.\n            "}]}]},{"classes":["actions"],"components":[{"type":"button","classes":["btn-primary"],"attributes":{"type":"button","id":"canvas-integration-btn"},"components":[{"type":"image","resizable":{"ratioDefault":1},"classes":["btn-icon"],"attributes":{"src":"https://api.iconify.design/mdi:school-outline.svg?color=currentColor&width=20&height=20"}},{"tagName":"span","type":"text","components":[{"type":"textnode","content":"Canvas Integration"}]}]}]}]}]},{"tagName":"section","attributes":{"id":"page-save-bar"},"components":[{"classes":["save-bar-inner"],"components":[{"type":"button","classes":["save-btn"],"attributes":{"type":"button","id":"save-settings-btn"},"components":[{"type":"image","resizable":{"ratioDefault":1},"classes":["btn-icon"],"attributes":{"src":"https://api.iconify.design/mdi:content-save-outline.svg?color=currentColor&width=20&height=20"}},{"tagName":"span","type":"text","components":[{"type":"textnode","content":"Save"}]}]}]}]}]}]}]},{"type":"script","components":[{"type":"textnode","content":"\n(function() {\n  const toggleBtn = document.getElementById('allow-late-toggle');\n\n  toggleBtn.addEventListener('click', function() {\n    const current = this.getAttribute('aria-checked') === 'true';\n    this.setAttribute('aria-checked', String(!current));\n  });\n\n  const canvasBtn = document.getElementById('canvas-integration-btn');\n\n  canvasBtn.addEventListener('click', function() {\n    alert('Canvas Integration: Proceed to connect your account.');\n  });\n\n  const saveBtn = document.getElementById('save-settings-btn');\n\n  saveBtn.addEventListener('click', function() {\n    alert('Settings saved successfully.');\n  });\n\n})();\n"}]}],"doctype":"<!DOCTYPE html>","h