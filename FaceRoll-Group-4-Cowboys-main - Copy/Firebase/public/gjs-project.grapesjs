{"type":"textnode","content":"S1047"}]},{"type":"cell","name":"Cell Date","draggable":["tr"],"classes":["cell-date"],"components":[{"type":"textnode","content":"2026-03-02"}]},{"type":"cell","name":"Cell Status","draggable":["tr"],"classes":["cell-status"],"components":[{"tagName":"span","type":"text","name":"Status Badge","classes":["status-badge"],"attributes":{"id":"ipaluo"},"components":[{"type":"textnode","content":"Late"}]}]},{"type":"cell","name":"Cell Notes","draggable":["tr"],"classes":["cell-notes"],"attributes":{"id":"iglzgf"},"components":[{"type":"textnode","content":"Bus delay"}]}]},{"type":"row","name":"Table Row","draggable":["thead","tbody","tfoot"],"droppable":["th","td"],"components":[{"type":"cell","name":"Cell Name","draggable":["tr"],"classes":["cell-name"],"components":[{"type":"textnode","content":"Noah Brown"}]},{"type":"cell","name":"Cell ID","draggable":["tr"],"classes":["cell-id"],"components":[{"type":"textnode","content":"S1050"}]},{"type":"cell","name":"Cell Date","draggable":["tr"],"classes":["cell-date"],"components":[{"type":"textnode","content":"2026-03-02"}]},{"type":"cell","name":"Cell Status","draggable":["tr"],"classes":["cell-status"],"components":[{"tagName":"span","type":"text","name":"Status Badge","classes":["status-badge"],"attributes":{"id":"idy70m"},"components":[{"type":"textnode","content":"Absent"}]}]},{"type":"cell","name":"Cell Notes","draggable":["tr"],"classes":["cell-notes"],"attributes":{"id":"ifypzw"},"components":[{"type":"textnode","content":"Unexcused"}]}]}]}]}]},{"name":"Table Footer Meta","classes":["table-footer-meta"],"components":[{"type":"text","name":"Table Footer Info","components":[{"type":"textnode","content":"Showing 1–7 of 120"}]},{"name":"Table Footer Controls","classes":["table-footer-controls"],"components":[{"type":"button","name":"Pagination Prev","classes":["pagination-prev"],"attributes":{"type":"button"},"components":[{"type":"contentEditable","components":[{"type":"textnode","content":"Previous"}]}]},{"type":"button","name":"Pagination Next","classes":["pagination-next"],"attributes":{"type":"button"},"components":[{"type":"contentEditable","components":[{"type":"textnode","content":"Next"}]}]}]}]}]}]}]},{"tagName":"footer","name":"Footer","classes":["gjs-t-border","footer"],"attributes":{"id":"inkyo6"},"components":[{"type":"text","name":"Footer Content","classes":["footer-content"],"attributes":{"id":"itfn6s"},"components":[{"type":"textnode","content":"© 2026 FaceRoll. All rights reserved."}]}]}]}]},{"type":"script","name":"Filtering and Export Script","components":[{"type":"textnode","content":"\n(function(){\n  const tbody = document.getElementById('attendanceTbody');\n  const rows = Array.from(tbody.querySelectorAll('tr'));\n  const dateFrom = document.getElementById('dateFrom');\n  const dateTo = document.getElementById('dateTo');\n  const statusFilter = document.getElementById('statusFilter');\n  const searchInput = document.getElementById('searchInput');\n  const applyBtn = document.getElementById('applyFilters');\n  const clearBtn = document.getElementById('clearFilters');\n  const exportBtn = document.getElementById('exportCsvBtn');\n  const exportBtnHeader = document.getElementById('exportCsvBtnHeader');\n\n  function normalizeDate(str){\n    const d = new Date(str);\n    return isNaN(d.getTime()) ? null : d;\n  }\n\n  function passesFilters(tr){\n    const tds = tr.querySelectorAll('td');\n    const name = tds[0].textContent.toLowerCase();\n    const id = tds[1].textContent.toLowerCase();\n    const dateStr = tds[2].textContent.trim();\n    const status = tds[3].textContent.trim();\n    const q = (searchInput.value || '').toLowerCase().trim();\n\n    if (q && !(name.includes(q) || id.includes(q))) return false;\n\n    const fromStr = dateFrom.value;\n    const toStr = dateTo.value;\n    if (fromStr){\n      const from = normalizeDate(fromStr);\n      const rowDate = normalizeDate(dateStr);\n      if (from && rowDate && rowDate < from) return false;\n    }\n    if (toStr){\n      const to = normalizeDate(toStr);\n      const rowDate = normalizeDate(dateStr);\n      if (to && rowDate && rowDate > to) return false;\n    }\n\n    const statusVal = statusFilter.value;\n    if (statusVal && status !== statusVal) return false;\n\n    return true;\n  }\n\n  function applyFiltersNow(){\n    rows.forEach(tr=>{\n      tr.style.display = passesFilters(tr) ? '' : 'none';\n    });\n  }\n\n  function clearFiltersNow(){\n    dateFrom.value = '';\n    dateTo.value = '';\n    statusFilter.value = '';\n    searchInput.value = '';\n    applyFiltersNow();\n  }\n\n  function exportVisibleToCSV(){\n    const headers = ['Student Name','Student ID','Date','Status','Notes'];\n    const visibleRows = rows.filter(r => r.style.display !== 'none');\n    const data = visibleRows.map(tr => Array.from(tr.querySelectorAll('td')).map(td => td.textContent.trim()));\n    const csv = [headers].concat(data).map(r => r.map(v => `\"${v.replace(/\"/g,'\"\"')}\"`).join(',')).join('\\n');\n    const blob = new Blob([csv], {type:'text/csv;charset=utf-8;'});\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement('a');\n    const now = new Date();\n    const stamp = now.toISOString().slice(0,10);\n    a.href = url;\n    a.download = `attendance_${stamp}.csv`;\n    document.body.appendChild(a);\n    a.click();\n    a.remove();\n    URL.revokeObjectURL(url);\n  }\n\n  applyBtn.addEventListener('click', applyFiltersNow);\n  clearBtn.addEventListener('click', clearFiltersNow);\n  exportBtn.addEventListener('click', exportVisibleToCSV);\n  exportBtnHeader.addEventListener('click', exportVisibleToCSV);\n})();\n"}]}],"doctype":"<!DOCTYPE html>","head":{"type":"head","components":[{"tagName":"meta","void":true,"attributes":{"charset":"utf-8"}},{"tagName":"meta","void":true,"attributes":{"name":"viewport","content":"width=device-width, initial-scale=1"}},{"tagName":"title","type":"text","components":[{"type":"textnode","content":"Instructor Admin Dashboard — Attendance Monitor"}]},{"tagName":"link","void":true,"attributes":{"href":"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap","rel":"stylesheet"}}]},"docEl":{"tagName":"html","attributes":{"lang":"en"}}},"id":"j5vWewmQVzIEew9H","minHeight":"500px"}],"id":"6E8XVxzvu59v53zD"},{"name":"Settings","frames":[{"component":{"type":"wrapper","classes":["body-root"],"attributes":{"id":"i098oc"},"components":[{"classes":["app-wrapper"],"components":[{"type":"comment","content":" Sidebar "},{"tagName":"nav","classes":["sidebar-navigation"],"components":[{"classes":["sidebar-header"],"components":[{"classes":["logo-text-group"],"components":[{"tagName":"span","type":"text","classes":["brand-name"],"attributes":{"id":"i41tvjv"},"components":[{"type":"textnode","content":"FaceRoll"}]},{"tagName":"span","type":"text","classes":["brand-tagline"],"components":[{"type":"textnode","content":"Instructor"}]}]}]},{"classes":["sidebar-menu"],"components":[{"tagName":"ul","classes":["sidebar-menu-list"],"components":[{"tagName":"li","components":[{"type":"link","editable":false,"classes":["sidebar-link"],"attributes":{"href":"#"},"components":[{"tagName":"span","type":"text","classes":["sidebar-link-label"],"components":[{"type":"textnode","content":"Dashboard"}]}]}]},{"tagName":"li","components":[{"type":"link","editable":false,"classes":["sidebar-link"],"attributes":{"href":"#"},"components":[{"tagName":"span","type":"text","classes":["sidebar-link-label"],"components":[{"type":"textnode","content":"Students"}]}]}]},{"tagName":"li","components":[{"type":"link","editable":false,"classes":["sidebar-link"],"attributes":{"href":"#"},"components":[{"tagName":"span","type":"text","classes":["sidebar-link-label"],"components":[{"type":"textnode","content":"Live Session"}]}]}]},{"tagName":"li","components":[{"type":"link","editable":false,"classes":["sidebar-link"],"attributes":{"href":"#"},"components"