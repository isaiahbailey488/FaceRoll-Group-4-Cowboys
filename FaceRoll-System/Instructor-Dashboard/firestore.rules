rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isInstructorOrAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['instructor', 'admin', 'administrator'];
    }

    function hasValidCourseLocation() {
      return !request.resource.data.keys().hasAny(['location'])
        || (
          request.resource.data.location.keys().hasOnly([
            'latitude',
            'longitude',
            'radiusMeters',
            'addressLabel',
            'enabled',
            'updatedAt',
            'updatedBy'
          ])
          && request.resource.data.location.latitude is number
          && request.resource.data.location.latitude >= -90
          && request.resource.data.location.latitude <= 90
          && request.resource.data.location.longitude is number
          && request.resource.data.location.longitude >= -180
          && request.resource.data.location.longitude <= 180
          && request.resource.data.location.radiusMeters in [20, 25, 30, 50]
          && request.resource.data.location.addressLabel is string
          && request.resource.data.location.addressLabel.size() > 0
          && request.resource.data.location.addressLabel.size() <= 200
          && request.resource.data.location.enabled is bool
          && request.resource.data.location.updatedAt is timestamp
          && request.resource.data.location.updatedBy == request.auth.uid
        );
    }

    function hasNoBiometricPayload() {
      return !request.resource.data.keys().hasAny([
          'image',
          'images',
          'photo',
          'photos',
          'base64',
          'embedding',
          'embeddings',
          'vector',
          'vectors'
        ]);
    }

    function isValidAttendanceRecord(recordId) {
      return request.resource.data.uid is string
        && request.resource.data.sessionId is string
        && recordId == request.resource.data.sessionId + '_' + request.resource.data.uid
        && hasNoBiometricPayload();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isInstructorOrAdmin();
      allow create: if isOwner(uid) && hasNoBiometricPayload();
      allow update: if hasNoBiometricPayload()
        && (
          isInstructorOrAdmin()
          || (isOwner(uid) && request.resource.data.role == resource.data.role)
        );
      allow delete: if isInstructorOrAdmin();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create, update: if isInstructorOrAdmin()
        && hasValidCourseLocation()
        && hasNoBiometricPayload();
      allow delete: if isInstructorOrAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update: if isInstructorOrAdmin() && hasNoBiometricPayload();
      allow delete: if isInstructorOrAdmin();
    }

    match /attendance/{recordId} {
      // Reading a missing deterministic record is required by the create-only
      // attendance transaction. Existing records remain owner/instructor only.
      allow get: if isSignedIn()
        && (resource == null || resource.data.uid == request.auth.uid || isInstructorOrAdmin());
      allow list: if isSignedIn()
        && (isInstructorOrAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isValidAttendanceRecord(recordId)
        && (
          isInstructorOrAdmin()
          || (isSignedIn() && request.resource.data.uid == request.auth.uid)
        );
      allow update: if isInstructorOrAdmin() && hasNoBiometricPayload();
      allow delete: if isInstructorOrAdmin();
    }

    match /facialEmbeddings/{uid} {
      // Face embeddings belong only in private instructor-device storage.
      allow read, write: if false;
    }

    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn();
      allow create, update: if isInstructorOrAdmin() && hasNoBiometricPayload();
      allow delete: if isInstructorOrAdmin();
    }

    match /instructor_settings/{uid} {
      allow read: if isOwner(uid) && isInstructorOrAdmin();
      allow create, update: if isOwner(uid)
        && isInstructorOrAdmin()
        && hasNoBiometricPayload();
      allow delete: if isOwner(uid) && isInstructorOrAdmin();
    }
  }
}
