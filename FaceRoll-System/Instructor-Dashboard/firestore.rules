rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Invitations are managed only by the authenticated Admin SDK service.
    match /courseInvitations/{tokenHash} {
      allow read, write: if false;
    }
    match /courseInvitationHeads/{courseId} {
      allow read, write: if false;
    }
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isInstructorOrAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['instructor', 'admin', 'administrator'];
    }

    function hasValidCourseLocation() {
      return !request.resource.data.keys().hasAny(['location'])
        || (
          request.resource.data.location.keys().hasOnly([
            'latitude',
            'longitude',
            'radiusMeters',
            'addressLabel',
            'enabled',
            'updatedAt',
            'updatedBy'
          ])
          && request.resource.data.location.latitude is number
          && request.resource.data.location.latitude >= -90
          && request.resource.data.location.latitude <= 90
          && request.resource.data.location.longitude is number
          && request.resource.data.location.longitude >= -180
          && request.resource.data.location.longitude <= 180
          && request.resource.data.location.radiusMeters is number
          && request.resource.data.location.radiusMeters >= 1
          && request.resource.data.location.radiusMeters <= 15
          && request.resource.data.location.radiusMeters % 1 == 0
          && request.resource.data.location.addressLabel is string
          && request.resource.data.location.addressLabel.size() > 0
          && request.resource.data.location.addressLabel.size() <= 200
          && request.resource.data.location.enabled is bool
          && request.resource.data.location.updatedAt is timestamp
          && request.resource.data.location.updatedBy == request.auth.uid
        );
    }

    function hasNoBiometricPayload() {
      return !request.resource.data.keys().hasAny([
          'image',
          'images',
          'photo',
          'photos',
          'base64',
          'embedding',
          'embeddings',
          'vector',
          'vectors'
        ]);
    }

    function hasValidStudentId() {
      return request.resource.data.role != 'student'
        || (
          request.resource.data.studentId is string
          && request.resource.data.studentId.matches('^[0-9]{7}$')
        );
    }

    function isValidAttendanceRecord(recordId) {
      return request.resource.data.uid is string
        && request.resource.data.sessionId is string
        && request.resource.data.courseId is string
        && request.resource.data.membershipId is string
        && recordId == request.resource.data.sessionId + '_' + request.resource.data.uid
        && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.courseId
          == request.resource.data.courseId
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'active'
        && !get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.keys().hasAny(['endTime'])
        && exists(/databases/$(database)/documents/enrollments/$(request.resource.data.membershipId))
        && get(/databases/$(database)/documents/enrollments/$(request.resource.data.membershipId)).data.uid
          == request.resource.data.uid
        && get(/databases/$(database)/documents/enrollments/$(request.resource.data.membershipId)).data.courseId
          == request.resource.data.courseId
        && get(/databases/$(database)/documents/enrollments/$(request.resource.data.membershipId)).data.status == 'active'
        && hasNoBiometricPayload();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isInstructorOrAdmin();
      allow create: if isOwner(uid) && hasNoBiometricPayload() && hasValidStudentId();
      allow update: if hasNoBiometricPayload() && hasValidStudentId()
        && (
          isInstructorOrAdmin()
          || (
            isOwner(uid)
            && request.resource.data.role == resource.data.role
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.studentId == resource.data.studentId
          )
        );
      allow delete: if isInstructorOrAdmin();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create: if isInstructorOrAdmin()
        && request.resource.data.instructorId == request.auth.uid
        && hasValidCourseLocation()
        && hasNoBiometricPayload();
      allow update: if isInstructorOrAdmin()
        && resource.data.instructorId == request.auth.uid
        && request.resource.data.instructorId == resource.data.instructorId
        && hasValidCourseLocation()
        && hasNoBiometricPayload();
      // Deletion is performed by the authenticated backend so related records
      // can be removed atomically.
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isInstructorOrAdmin()
        && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId))
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.instructorId == request.auth.uid
        && hasNoBiometricPayload();
      allow update: if isInstructorOrAdmin()
        && request.resource.data.courseId == resource.data.courseId
        && exists(/databases/$(database)/documents/courses/$(resource.data.courseId))
        && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.instructorId == request.auth.uid
        && hasNoBiometricPayload();
      allow delete: if isInstructorOrAdmin()
        && exists(/databases/$(database)/documents/courses/$(resource.data.courseId))
        && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.instructorId == request.auth.uid;
    }

    match /attendance/{recordId} {
      // Reading a missing deterministic record is required by the create-only
      // attendance transaction. Existing records remain owner/instructor only.
      allow get: if isSignedIn()
        && (resource == null || resource.data.uid == request.auth.uid || isInstructorOrAdmin());
      allow list: if isSignedIn()
        && (isInstructorOrAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isValidAttendanceRecord(recordId)
        && (
          isInstructorOrAdmin()
          || (isSignedIn() && request.resource.data.uid == request.auth.uid)
        );
      allow update: if isInstructorOrAdmin() && hasNoBiometricPayload();
      allow delete: if isInstructorOrAdmin();
    }

    match /facialEmbeddings/{uid} {
      // Face embeddings belong only in private instructor-device storage.
      allow read, write: if false;
    }

    match /enrollments/{enrollmentId} {
      allow get: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isInstructorOrAdmin());
      allow list: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isInstructorOrAdmin());
      allow create, update: if isInstructorOrAdmin() && hasNoBiometricPayload();
      allow delete: if isInstructorOrAdmin();
    }

    match /instructor_settings/{uid} {
      allow read: if isOwner(uid) && isInstructorOrAdmin();
      allow create, update: if isOwner(uid)
        && isInstructorOrAdmin()
        && hasNoBiometricPayload();
      allow delete: if isOwner(uid) && isInstructorOrAdmin();
    }
  }
}
