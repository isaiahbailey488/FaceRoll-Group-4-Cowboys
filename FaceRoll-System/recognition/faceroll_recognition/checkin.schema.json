{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FaceRoll verified check-in v1",
  "$defs": {
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "sessionId", "image", "location"],
      "properties": {
        "schemaVersion": {"type": "integer", "enum": [1]},
        "sessionId": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9_-]+$"},
        "image": {"type": ["string", "null"], "minLength": 4, "maxLength": 8000000, "format": "base64"},
        "location": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["latitude", "longitude", "accuracyMeters", "capturedAtMs", "mocked"],
          "properties": {
            "latitude": {"type": "number", "minimum": -90, "maximum": 90},
            "longitude": {"type": "number", "minimum": -180, "maximum": 180},
            "accuracyMeters": {"type": "number", "minimum": 0, "maximum": 10000},
            "capturedAtMs": {"type": "integer", "minimum": 1, "maximum": 8640000000000000},
            "mocked": {"type": ["boolean", "null"]}
          }
        }
      }
    },
    "success": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "success", "attendanceId", "sessionId", "courseId", "status", "locationStatus", "recordedAt", "duplicate"],
      "properties": {
        "schemaVersion": {"type": "integer", "enum": [1]},
        "success": {"type": "boolean", "enum": [true]},
        "attendanceId": {"type": "string", "minLength": 1, "maxLength": 400, "pattern": "^[A-Za-z0-9_-]+$"},
        "sessionId": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9_-]+$"},
        "courseId": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9_-]+$"},
        "status": {"type": "string", "enum": ["present", "late"]},
        "locationStatus": {"type": "string", "enum": ["in_zone", "not_required"]},
        "recordedAt": {"type": "string", "format": "utc-milliseconds"},
        "duplicate": {"type": "boolean"}
      }
    }
  }
}
