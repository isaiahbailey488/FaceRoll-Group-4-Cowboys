{
  "expo": {
    "name": "FaceRoll",
    "slug": "faceroll-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "faceroll",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cowboys.faceroll",
      "infoPlist": {
        "NSCameraUsageDescription": "FaceRoll uses your camera to scan course invitations, enroll your face, and check in for attendance."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A2342"
      },
      "package": "com.cowboys.faceroll",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "FaceRoll uses your camera to scan course invitations, enroll your face, and check in for attendance."
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#0A2342"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
