{
  "expo": {
    "name": "FaceRoll",
    "slug": "faceroll-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "faceroll",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cowboys.faceroll",
      "infoPlist": {
        "NSCameraUsageDescription": "FaceRoll uses your camera to scan course invitations, enroll your face, and check in for attendance."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCFCFD"
      },
      "package": "com.cowboys.faceroll",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "FaceRoll uses your camera to scan course invitations, enroll your face, and check in for attendance."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FaceRoll uses a fresh location sample for classroom check-in. Your coordinates are temporary and are not saved in your attendance history.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidMotionActivityEnabled": false
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#FCFCFD"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
