rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Invitations are managed only by the authenticated Admin SDK service.
    match /courseInvitations/{tokenHash} {
      allow read, write: if false;
    }
    match /courseInvitationHeads/{courseId} {
      allow read, write: if false;
    }
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isInstructorOrAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['instructor', 'admin', 'administrator'];
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'administrator'];
    }

    function ownsCourse(courseId) {
      return isInstructorOrAdmin() && courseId is string
        && get(/databases/$(database)/documents/courses/$(courseId)).data.instructorId == request.auth.uid;
    }

    function managesCourse(courseId) {
      return isAdmin() || ownsCourse(courseId);
    }

    function validStudentAccess(access, uid) {
      return access.keys().hasOnly(['uid', 'courseId', 'membershipId', 'attendanceId'])
        && access.uid == uid && ownsCourse(access.courseId)
        && ((access.get('membershipId', '') != ''
            && get(/databases/$(database)/documents/enrollments/$(access.membershipId)).data.uid == uid
            && get(/databases/$(database)/documents/enrollments/$(access.membershipId)).data.courseId == access.courseId)
          || (access.get('attendanceId', '') != ''
            && get(/databases/$(database)/documents/attendance/$(access.attendanceId)).data.uid == uid
            && get(/databases/$(database)/documents/attendance/$(access.attendanceId)).data.courseId == access.courseId));
    }

    function canReadStudent(uid) {
      return isInstructorOrAdmin()
        && exists(/databases/$(database)/documents/instructorStudentAccess/$(request.auth.uid)/students/$(uid))
        && validStudentAccess(get(/databases/$(database)/documents/instructorStudentAccess/$(request.auth.uid)/students/$(uid)).data, uid);
    }

    // These links never grant authority on their own: every profile read also
    // rechecks ownership and the referenced membership or attendance record.
    match /instructorStudentAccess/{instructorUid}/students/{uid} {
      allow get: if isOwner(instructorUid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(instructorUid) && validStudentAccess(request.resource.data, uid);
      allow delete: if isOwner(instructorUid) || isAdmin();
    }

    function isValidInstructorOverride(recordId) {
      let row = request.resource.data;
      return managesCourse(row.courseId)
        && row.source == 'instructor_override'
        && row.status in ['present', 'late', 'absent']
        && row.uid is string && row.sessionId is string
        && recordId == row.sessionId + '_' + row.uid
        && get(/databases/$(database)/documents/sessions/$(row.sessionId)).data.courseId == row.courseId
        && !(get(/databases/$(database)/documents/sessions/$(row.sessionId)).data.get('status', '') in ['starting', 'start_failed', 'cancelled'])
        && ((row.get('membershipId', '') != ''
            && get(/databases/$(database)/documents/enrollments/$(row.membershipId)).data.uid == row.uid
            && get(/databases/$(database)/documents/enrollments/$(row.membershipId)).data.courseId == row.courseId)
          || (row.get('attendanceEvidenceId', '') != ''
            && get(/databases/$(database)/documents/attendance/$(row.attendanceEvidenceId)).data.uid == row.uid
            && get(/databases/$(database)/documents/attendance/$(row.attendanceEvidenceId)).data.courseId == row.courseId))
        && hasNoBiometricPayload();
    }

    function priorZoneRevision() {
      let previous = resource == null ? null : resource.data.get('location', null);
      return previous is map ? previous.get('revision', 0) : 0;
    }

    function hasValidCourseLocation() {
      return !request.resource.data.keys().hasAny(['location'])
        || (
          request.resource.data.location.keys().hasOnly([
            'latitude',
            'longitude',
            'radiusMeters',
            'addressLabel',
            'enabled',
            'updatedAt',
            'updatedBy',
            'revision'
          ])
          && request.resource.data.location.latitude is number
          && request.resource.data.location.latitude >= -90
          && request.resource.data.location.latitude <= 90
          && request.resource.data.location.longitude is number
          && request.resource.data.location.longitude >= -180
          && request.resource.data.location.longitude <= 180
          && request.resource.data.location.radiusMeters is number
          && request.resource.data.location.radiusMeters >= 1
          && request.resource.data.location.radiusMeters <= 15
          && request.resource.data.location.radiusMeters % 1 == 0
          && request.resource.data.location.addressLabel is string
          && request.resource.data.location.addressLabel.size() > 0
          && request.resource.data.location.addressLabel.size() <= 200
          && request.resource.data.location.enabled is bool
          && request.resource.data.location.updatedAt is timestamp
          && request.resource.data.location.updatedBy == request.auth.uid
          && (resource != null && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['location'])
            || (!request.resource.data.location.keys().hasAny(['revision']) && priorZoneRevision() == 0)
            || (request.resource.data.location.revision is int
              && request.resource.data.location.revision >= 1
              && request.resource.data.location.revision <= 1000000000
              && request.resource.data.location.revision == priorZoneRevision() + 1))
        );
    }

    function hasNoBiometricPayload() {
      return !request.resource.data.keys().hasAny([
          'image',
          'images',
          'photo',
          'photos',
          'base64',
          'embedding',
          'embeddings',
          'vector',
          'vectors'
        ]);
    }

    function hasValidStudentId() {
      return request.resource.data.role != 'student'
        || (
          request.resource.data.studentId is string
          && request.resource.data.studentId.matches('^[0-9]{7}$')
        );
    }

    function sessionAcceptsAttendance(session) {
      // This path is only for course managers. Student check-in policy is
      // evaluated by the authenticated backend before its Admin SDK write.
      return managesCourse(session.courseId) && (
        (session.status == 'active' && !session.keys().hasAny(['endTime']))
        || (request.resource.data.get('source', '') == 'session_default'
          && session.status in ['closing', 'closed']
          && request.resource.data.status == session.get('defaultAttendance', 'absent')));
    }

    function isValidAttendanceRecord(recordId) {
      return request.resource.data.uid is string
        && request.resource.data.sessionId is string
        && request.resource.data.courseId is string
        && request.resource.data.membershipId is string
        && recordId == request.resource.data.sessionId + '_' + request.resource.data.uid
        && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.courseId
          == request.resource.data.courseId
        && sessionAcceptsAttendance(get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data)
        && exists(/databases/$(database)/documents/enrollments/$(request.resource.data.membershipId))
        && get(/databases/$(database)/documents/enrollments/$(request.resource.data.membershipId)).data.uid
          == request.resource.data.uid
        && get(/databases/$(database)/documents/enrollments/$(request.resource.data.membershipId)).data.courseId
          == request.resource.data.courseId
        && get(/databases/$(database)/documents/enrollments/$(request.resource.data.membershipId)).data.status == 'active'
        && hasNoBiometricPayload();
    }


    function hasValidFacePrivacy() {
      return request.resource.data.get('optOutFlag', false) is bool
        && request.resource.data.get('faceEnrolled', false) is bool
        && request.resource.data.get('faceConsentRevision', 0) is int
        && request.resource.data.get('faceConsentRevision', 0) >= 0
        && request.resource.data.get('faceDataDeletionStatus', 'none') in ['none', 'pending', 'deleted'];
    }

    function validInitialFacePrivacy() {
      return hasValidFacePrivacy()
        && request.resource.data.get('optOutFlag', false) == false
        && request.resource.data.get('faceEnrolled', false) == false
        && request.resource.data.get('faceConsentRevision', 0) == 0
        && request.resource.data.get('faceDataDeletionStatus', 'none') == 'none'
        && !request.resource.data.keys().hasAny(['faceEnrollmentServers', 'faceDeletionCompletedAt', 'faceDeletionRequestedAt']);
    }

    function validFacePrivacyUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldOptOut = resource.data.get('optOutFlag', false);
      let newOptOut = request.resource.data.get('optOutFlag', false);
      let revision = resource.data.get('faceConsentRevision', 0);
      let protectedFields = ['faceConsentRevision', 'faceDataDeletionStatus', 'faceDeletionRequestedAt', 'faceDeletionCompletedAt'];
      return hasValidFacePrivacy()
        && !changed.hasAny(['faceEnrollmentServers', 'faceDeletionCompletedAt'])
        && (!changed.hasAny(['faceEnrolled']) || request.resource.data.get('faceEnrolled', false) == false)
        && (
          (oldOptOut == newOptOut
            && !changed.hasAny(protectedFields)
            && (!newOptOut || request.resource.data.get('faceEnrolled', false) == false)
            && (request.resource.data.get('faceDataDeletionStatus', 'none') != 'pending'
              || request.resource.data.get('faceEnrolled', false) == false))
          || (oldOptOut != newOptOut
            && request.resource.data.get('faceConsentRevision', 0) == revision + 1
            && request.resource.data.get('faceEnrolled', false) == false
            && (
              (newOptOut == true
                && request.resource.data.get('faceDataDeletionStatus', 'none') == 'pending'
                && request.resource.data.get('faceDeletionRequestedAt', null) == request.time)
              || (newOptOut == false
                && resource.data.get('faceDataDeletionStatus', 'none') == 'deleted'
                && !changed.hasAny(['faceDataDeletionStatus', 'faceDeletionRequestedAt']))
            ))
        );
    }

    function permitsFacialAttendance(uid) {
      let profile = get(/databases/$(database)/documents/users/$(uid)).data;
      return profile.get('optOutFlag', false) == false
        && profile.get('faceDataDeletionStatus', 'none') != 'pending'
        && (profile.get('faceConsentRevision', 0) == 0 || profile.get('faceEnrolled', false) == true);
    }
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin() || canReadStudent(uid);
      allow list: if isAdmin();
      allow create: if isOwner(uid) && hasNoBiometricPayload() && hasValidStudentId() && validInitialFacePrivacy();
      allow update: if hasNoBiometricPayload() && hasValidStudentId() && validFacePrivacyUpdate()
        && (
          isAdmin()
          || (
            isOwner(uid)
            && request.resource.data.role == resource.data.role
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.studentId == resource.data.studentId
          )
        );
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn() && (!isInstructorOrAdmin() || isAdmin() || resource.data.instructorId == request.auth.uid);
      allow create: if isInstructorOrAdmin()
        && request.resource.data.instructorId == request.auth.uid
        && hasValidCourseLocation()
        && hasNoBiometricPayload();
      allow update: if managesCourse(courseId)
        && request.resource.data.instructorId == resource.data.instructorId
        && hasValidCourseLocation()
        && hasNoBiometricPayload();
      // Deletion is performed by the authenticated backend so related records
      // can be removed atomically.
      allow delete: if false;
    }

    function validSessionZone() {
      return !request.resource.data.keys().hasAny(['zonePolicyVersion', 'classroomZone'])
        || (request.resource.data.zonePolicyVersion is int
          && request.resource.data.zonePolicyVersion == 1
          && request.resource.data.keys().hasAll(['classroomZone'])
          && request.resource.data.classroomZone == get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.get('location', null));
    }

    function stableSessionZone() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['zonePolicyVersion', 'classroomZone'])
        || (!resource.data.keys().hasAny(['zonePolicyVersion', 'classroomZone']) && validSessionZone());
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn() && (resource == null || !isInstructorOrAdmin() || managesCourse(resource.data.courseId));
      allow create: if isInstructorOrAdmin()
        && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId))
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.instructorId == request.auth.uid
        && request.resource.data.keys().hasAll(['zonePolicyVersion', 'classroomZone'])
        && validSessionZone()
        && hasNoBiometricPayload();
      allow update: if isInstructorOrAdmin()
        && request.resource.data.courseId == resource.data.courseId
        && stableSessionZone()
        && exists(/databases/$(database)/documents/courses/$(resource.data.courseId))
        && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.instructorId == request.auth.uid
        && hasNoBiometricPayload();
      allow delete: if isInstructorOrAdmin()
        && exists(/databases/$(database)/documents/courses/$(resource.data.courseId))
        && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.instructorId == request.auth.uid;
    }

    // Allow only attendance metadata, never a student position or location object.
    function hasPrivateAttendanceShape() {
      return request.resource.data.keys().hasOnly([
        'id', 'uid', 'userId', 'sessionId', 'courseId', 'membershipId', 'status', 'method',
        'source', 'time', 'createdAt', 'studentName', 'displayName',
        'matchedUser', 'recognitionIdentity', 'recognitionLabel',
        'recognitionConfidence', 'recognitionDistance', 'locationStatus', 'attendanceEvidenceId'
      ]) && (!request.resource.data.keys().hasAny(['locationStatus'])
        || request.resource.data.locationStatus in ['in_zone', 'outside_zone', 'not_required', 'not_checked'])
        && (!request.resource.data.keys().hasAny(['id']) || request.resource.data.id is string)
        && (!request.resource.data.keys().hasAny(['uid']) || request.resource.data.uid is string)
        && (!request.resource.data.keys().hasAny(['userId']) || request.resource.data.userId is string)
        && (!request.resource.data.keys().hasAny(['sessionId']) || request.resource.data.sessionId is string)
        && (!request.resource.data.keys().hasAny(['courseId']) || request.resource.data.courseId is string)
        && (!request.resource.data.keys().hasAny(['membershipId']) || request.resource.data.membershipId is string)
        && (!request.resource.data.keys().hasAny(['attendanceEvidenceId']) || request.resource.data.attendanceEvidenceId is string)
        && (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status is string)
        && (!request.resource.data.keys().hasAny(['method']) || request.resource.data.method is string)
        && (!request.resource.data.keys().hasAny(['source']) || request.resource.data.source is string)
        && (!request.resource.data.keys().hasAny(['studentName']) || request.resource.data.studentName is string)
        && (!request.resource.data.keys().hasAny(['displayName']) || request.resource.data.displayName is string)
        && (!request.resource.data.keys().hasAny(['recognitionIdentity']) || request.resource.data.recognitionIdentity is string)
        && (!request.resource.data.keys().hasAny(['recognitionLabel']) || request.resource.data.recognitionLabel is string)
        && (!request.resource.data.keys().hasAny(['time']) || request.resource.data.time is string || request.resource.data.time is timestamp)
        && (!request.resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt is string || request.resource.data.createdAt is timestamp)
        && (!request.resource.data.keys().hasAny(['matchedUser']) || request.resource.data.matchedUser is bool)
        && (!request.resource.data.keys().hasAny(['recognitionConfidence']) || request.resource.data.recognitionConfidence is number)
        && (!request.resource.data.keys().hasAny(['recognitionDistance']) || request.resource.data.recognitionDistance is number);
    }

    match /attendance/{recordId} {
      allow get: if isSignedIn()
        && (resource == null || resource.data.uid == request.auth.uid || managesCourse(resource.data.courseId));
      allow list: if isSignedIn()
        && (resource.data.uid == request.auth.uid || managesCourse(resource.data.courseId));
      // Students cannot create attendance directly, regardless of source or
      // claimed location status. Only the backend can finalize phone check-ins.
      allow create: if managesCourse(request.resource.data.courseId)
        && hasPrivateAttendanceShape() && (isValidInstructorOverride(recordId)
        || (isValidAttendanceRecord(recordId)
          && (!(request.resource.data.get('source', '') in ['phone_face_verification', 'classroom_camera'])
            || permitsFacialAttendance(request.resource.data.uid))));
      allow update: if managesCourse(resource.data.courseId) && hasNoBiometricPayload()
        && hasPrivateAttendanceShape() && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.status in ['present', 'late', 'absent'];
      allow delete: if managesCourse(resource.data.courseId);
    }

    match /attendanceCheckIns/{recordId} {
      // Idempotency receipts are created only by the authenticated backend.
      allow read, write: if false;
    }

    match /facialEmbeddings/{uid} {
      // Face embeddings belong only in private instructor-device storage.
      allow read, write: if false;
    }

    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || managesCourse(resource.data.courseId));
      allow create: if managesCourse(request.resource.data.courseId) && hasNoBiometricPayload();
      allow update: if managesCourse(resource.data.courseId) && hasNoBiometricPayload()
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.uid == resource.data.uid;
      allow delete: if managesCourse(resource.data.courseId);
    }

    match /instructor_settings/{uid} {
      allow read: if isOwner(uid) && isInstructorOrAdmin();
      allow create, update: if isOwner(uid)
        && isInstructorOrAdmin()
        && hasNoBiometricPayload();
      allow delete: if isOwner(uid) && isInstructorOrAdmin();
    }
  }
}
