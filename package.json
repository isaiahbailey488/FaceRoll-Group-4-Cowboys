{
  "name": "faceroll-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "tunnel": "expo start --tunnel --go",
    "demo": "node scripts/demo.js",
    "demo:lan": "node scripts/demo.js --local",
    "demo:tunnel": "node scripts/demo.js --tailscale",
    "demo:check": "node scripts/demo.js --check",
    "test:demo": "node --test scripts/demo.test.js",
    "test:lan:https": "node --test scripts/lan-https.test.js",
    "test:contracts": "node --test shared/course-contracts.test.js",
    "test:course-join": "node --test shared/course-join.test.js",
    "test:auth-session": "node --test shared/auth-session.test.js",
    "test:step1": "node --test shared/checkin-contract.test.js shared/transport-config.test.js shared/firebase-transport.test.js scripts/secure-transport.test.js scripts/demo.test.js",
    "test:step1:https": "node scripts/verify-step1-https.cjs",
    "test:step2:emulator": "node scripts/verify-step2.cjs",
    "test:step3": "node --test shared/checkin-location*.test.js shared/capture-camera.test.js shared/face-privacy-screens.test.js",
    "test:step4": "node --test shared/checkin-api.test.js shared/checkin-contract.test.js shared/checkin-location*.test.js shared/capture-camera.test.js shared/face-privacy-screens.test.js",
    "test:step5": "node --test shared/attendance-read.test.js shared/checkin-api.test.js shared/capture-camera.test.js shared/face-privacy-screens.test.js",
    "test:step5:emulator": "node scripts/verify-step2.cjs",
    "test:step6": "node scripts/verify-step6.cjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.19",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "firebase": "^12.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
